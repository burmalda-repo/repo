{
    "name": "btop",
    "version": "1.3.2",
    "description": "A monitor of resources that emphasizes the capabilities and vector graphics of the terminal.",
    "source": "https://github.com/aristocratos/btop/archive/refs/tags/v1.3.2.tar.gz",
    "sha256": "331d18488b1dc7f06cfa12cff909230816a24c57790ba3e8224b117e3f0ae03e",
    "prepare": [
        "sed -i 's/ -O2/ /g' Makefile"
    ],
    "configure": [./configure --prefix=/usr],
    "build": [
        "make -j{{THREADS}}"
    ],
    "install": [
        "make install PREFIX=/usr"
    ]
}
